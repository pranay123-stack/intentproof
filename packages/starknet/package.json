{
  "name": "@intentproof/starknet",
  "version": "0.1.0",
  "description": "Starknet IntentRegistry client, with an explicit local mode that never fabricates transactions.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
