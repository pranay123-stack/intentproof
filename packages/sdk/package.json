{
  "name": "@intentproof/sdk",
  "version": "0.1.0",
  "description": "IntentProof SDK: compile human intent, authorize it, and check every agent action against it.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@intentproof/agent": "workspace:*",
    "@intentproof/intent-compiler": "workspace:*",
    "@intentproof/intent-schema": "workspace:*",
    "@intentproof/policy-engine": "workspace:*",
    "@intentproof/starknet": "workspace:*"
  }
}
