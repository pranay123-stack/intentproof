# ---------------------------------------------------------------------------
# IntentProof environment
#
# Copy to .env and fill in. Every variable is optional: with none of them set
# the toolchain runs in LOCAL DEMO MODE, which computes real commitments and
# enforces the policy for real, but never claims anything reached a chain.
# ---------------------------------------------------------------------------

# --- OpenAI (server-side only) ---
# Required for the natural-language Intent Compiler.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.6.
OPENAI_MODEL=gpt-5.6

# When no OPENAI_API_KEY is present the SDK can fall back to a deterministic,
# rule-based compiler. It is NOT an LLM and reports isModelGenerated: false.
# Set to "false" to make a missing key a hard error instead.
INTENTPROOF_ALLOW_FALLBACK_COMPILER=true

# --- Starknet ---
# A Sepolia RPC endpoint. Leave blank for LOCAL DEMO MODE.
STARKNET_RPC_URL=https://starknet-sepolia.drpc.org
# The account that pays for register_intent / record_execution.
STARKNET_ACCOUNT_ADDRESS=
# Never commit this. Leave blank for read-only or local mode.
STARKNET_PRIVATE_KEY=
# Address of a deployed IntentRegistry. Produced by scripts/deploy-sepolia.
INTENT_REGISTRY_ADDRESS=
# Optional: deployed ExecutionVerifier.
EXECUTION_VERIFIER_ADDRESS=

# sepolia | mainnet
STARKNET_NETWORK=sepolia
