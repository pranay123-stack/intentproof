# ---------------------------------------------------------------------------
# IntentProof environment
#
# Copy to .env.local (Next.js) or .env (scripts) and fill in.
# Every variable is optional: with none of them set the app runs in
# LOCAL DEMO MODE, which computes real commitments but never claims they
# are on chain.
# ---------------------------------------------------------------------------

# --- OpenAI (server-side only; never expose to the browser) ---
# Required for the natural-language Intent Compiler.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.6.
OPENAI_MODEL=gpt-5.6

# When no OPENAI_API_KEY is present the app can fall back to a deterministic,
# rule-based compiler. It is NOT an LLM and the UI labels it as such.
# Set to "false" to make a missing key a hard error instead.
INTENTPROOF_ALLOW_FALLBACK_COMPILER=true

# --- Starknet ---
# A Sepolia RPC endpoint. Leave blank for LOCAL DEMO MODE.
STARKNET_RPC_URL=
# The account that pays for register_intent / record_execution.
STARKNET_ACCOUNT_ADDRESS=
# Never commit this. Leave blank for read-only or local mode.
STARKNET_PRIVATE_KEY=
# Address of a deployed IntentRegistry. Produced by scripts/deploy-sepolia.ts.
INTENT_REGISTRY_ADDRESS=
# Optional: deployed ExecutionVerifier.
EXECUTION_VERIFIER_ADDRESS=

# --- Public (safe to expose) ---
NEXT_PUBLIC_STARKNET_NETWORK=sepolia
# Shown on the homepage "GITHUB" button.
NEXT_PUBLIC_GITHUB_URL=https://github.com/pranay123-stack/intentproof
