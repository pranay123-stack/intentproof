#!/usr/bin/env bash
# Thin wrapper so the deployment has a stable, memorable entry point.
#
#   ./scripts/deploy-sepolia
#
# Requires Node 22+, a built Cairo target (`pnpm build:cairo`) and a funded
# Sepolia account in .env — see scripts/deploy-sepolia.ts for the checks.
set -euo pipefail
cd "$(dirname "$0")/.."
exec node --experimental-strip-types scripts/deploy-sepolia.ts "$@"
